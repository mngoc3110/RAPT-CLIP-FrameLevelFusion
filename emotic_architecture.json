    {
      "dot": "cyan",
      "title": "EMOTIC Specifics",
      "items": [
        "Uses all 3 crops: Face, Body, and Context",
        "Bypasses Temporal Net (t=1 for static images)",
        "Q2L Fusion uses Text Features as Queries and Image Features as Keys/Values"
      ]
    },
    {
      "dot": "emerald",
      "title": "Simplified Text Branch",
      "items": [
        "MI/DC Loss is disabled (lambda=0.0) to avoid gradient conflict with ASL",
        "Therefore, Handcrafted Prompts (Anchors) are omitted from the flow"
      ]
    },
    {
      "dot": "rose",
      "title": "Loss Strategy",
